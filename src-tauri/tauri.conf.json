{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src"
  },
  "package": {
    "productName": "FAMREV AI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "window": { "all": true },
      "notification": { "all": true },
      "globalShortcut": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis"],
      "identifier": "ai.famrev.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "publisher": "FAMREV",
      "shortDescription": "FAMREV AI",
      "longDescription": "FAMREV AI — private AI assistant",
      "windows": {
        "wix": { "language": "en-US" },
        "nsis": { "installMode": "currentUser" }
      }
    },
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": []
    },
    "updater": { "active": false },
    "windows": [
      {
        "title": "FAMREV AI",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "https://chat.famrev.ai",
        "decorations": true
      }
    ]
  }
}
