{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FAMREV AI",
  "version": "1.0.0",
  "identifier": "ai.famrev.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FAMREV AI",
        "label": "main",
        "url": "https://chat.famrev.ai",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://chat.famrev.ai/desktop/updates.json"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_YOUR_TAURI_PUBLIC_KEY"
    }
  }
}
