{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src"
  },
  "package": {
    "productName": "FAMREV AI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "window": { "all": true },
      "notification": { "all": true },
      "globalShortcut": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "identifier": "ai.famrev.desktop",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
      "publisher": "FAMREV"
    },
    "security": { "csp": null },
    "updater": { "active": false },
    "windows": [
      {
        "title": "FAMREV AI",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "https://chat.famrev.ai"
      }
    ]
  }
}
