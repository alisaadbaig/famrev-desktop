{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "What the FAMREV web pages may ask the desktop app to do. Only FAMREV's own addresses, only these commands: no files, no shell, no other windows.",
  "windows": ["main", "quickbox"],
  "remote": { "urls": ["https://chat.famrev.ai/*", "https://uat.famrev.ai/*"] },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-qb-show",
    "allow-qb-hide",
    "allow-qb-toggle",
    "allow-qb-resize",
    "allow-open-main",
    "allow-open-program",
    "allow-open-link",
    "allow-capture-screen",
    "allow-app-info"
  ]
}
